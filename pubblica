#!/usr/bin/env bash
#
# Toglie il flag di bozza e ricostruisce il sito, così gli errori saltano fuori
# qui e non dopo il push. Git non viene toccato: alla fine stampa il comando.
#
#   ./pubblica                                    tutte le bozze
#   ./pubblica content/pensieri/pocket-world.md   solo questa

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

errore() {
  echo "pubblica: $1" >&2
  exit 1
}

command -v hugo >/dev/null || errore "hugo non è nel PATH (mise use -g hugo@0.165.0)"

if (($#)); then
  file=("$@")
  for f in "${file[@]}"; do
    [[ -f $f ]] || errore "non trovo: $f"
  done
else
  mapfile -t file < <(grep -rl '^draft: true$' content --include='*.md' 2>/dev/null | sort)
fi

if ((${#file[@]} == 0)); then
  echo "nessuna bozza da pubblicare."
  exit 0
fi

# Backup: se il build fallisce si rimette tutto com'era, senza lasciare
# a metà pagine che non compilano.
backup="$(mktemp -d)"
trap 'rm -rf "$backup"' EXIT

pubblicati=()
for f in "${file[@]}"; do
  if grep -q '^draft: true$' "$f"; then
    mkdir -p "$backup/$(dirname "$f")"
    cp "$f" "$backup/$f"
    sed -i '/^draft: true$/d' "$f"
    pubblicati+=("$f")
  fi
done

if ((${#pubblicati[@]} == 0)); then
  echo "erano già tutte pubblicate."
  exit 0
fi

echo "tolto il flag di bozza da ${#pubblicati[@]} pagine:"
printf '  %s\n' "${pubblicati[@]}"
echo

if ! hugo --gc --minify; then
  echo
  echo "build fallito: rimetto le pagine in bozza." >&2
  for f in "${pubblicati[@]}"; do cp "$backup/$f" "$f"; done
  exit 1
fi

echo
echo "git non è stato toccato. Per mandare online:"
echo
echo "  git add -A && git commit -m 'nuovi contenuti' && git push"

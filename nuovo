#!/usr/bin/env bash
#
# Crea una pagina nuova già col front matter giusto, nella cartella giusta.
# Non tocca git: il file nasce come bozza, lo pubblichi con ./pubblica.
#
#   ./nuovo pensiero "Pocket World"
#   ./nuovo progetto "Map Generator"
#   ./nuovo disegno "Studio di mani" ~/foto/schizzo.png
#   ./nuovo pensiero --da ~/Obsidian/PENSIERI/Bozze/"2026-04-15 Pocket World.md"

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

uso() {
  cat >&2 <<'EOF'
uso:
  ./nuovo <sezione> "Titolo"                pagina vuota
  ./nuovo disegno "Titolo" immagine.png     disegno: cartella + immagine
  ./nuovo <sezione> --da nota.md            importa una nota da Obsidian

sezioni: pensiero | progetto | disegno   (vanno bene anche al plurale)
opzioni: --no-editor    non aprire l'editor alla fine
EOF
  exit 2
}

errore() {
  echo "nuovo: $1" >&2
  exit 1
}

# "Città di notte" -> "citta-di-notte". La prima sed translittera gli accenti
# uno per uno: iconv //TRANSLIT si comporta diversamente da sistema a sistema.
slugify() {
  printf '%s' "$1" |
    sed 'y/àáâãäèéêëìíîïòóôõöùúûüçñÀÁÂÃÄÈÉÊËÌÍÎÏÒÓÔÕÖÙÚÛÜÇÑ/aaaaaeeeeiiiiooooouuuucnAAAAAEEEEIIIIOOOOOUUUUCN/' |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

sorgente=""
apri_editor=1
positionali=()

while (($#)); do
  case "$1" in
    --da)
      [[ $# -ge 2 ]] || errore "--da vuole un file"
      sorgente="$2"
      shift 2
      ;;
    --no-editor)
      apri_editor=0
      shift
      ;;
    -h | --help) uso ;;
    -*) errore "opzione sconosciuta: $1" ;;
    *)
      positionali+=("$1")
      shift
      ;;
  esac
done

sezione="${positionali[0]-}"
titolo="${positionali[1]-}"
immagine="${positionali[2]-}"

case "$sezione" in
  pensiero | pensieri) sezione=pensieri ;;
  progetto | progetti) sezione=progetti ;;
  disegno | disegni) sezione=disegni ;;
  "") uso ;;
  *) errore "sezione sconosciuta: '$sezione' (pensiero, progetto o disegno)" ;;
esac

data="$(date +%F)"

# Le note del vault si chiamano "2026-04-15 Pocket World.md": da lì si ricavano
# sia la data sia il titolo, che è meglio che inventarseli.
if [[ -n $sorgente ]]; then
  [[ -f $sorgente ]] || errore "non trovo il file: $sorgente"
  base="$(basename "$sorgente" .md)"
  if [[ $base =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]_-]+(.+)$ ]]; then
    data="${BASH_REMATCH[1]}"
    [[ -z $titolo ]] && titolo="${BASH_REMATCH[2]}"
  else
    [[ -z $titolo ]] && titolo="$base"
  fi
fi

[[ -n $titolo ]] || errore "manca il titolo"

slug="$(slugify "$titolo")"
[[ -n $slug ]] || errore "dal titolo '$titolo' non esce nessun nome di file usabile"

if [[ $sezione == disegni ]]; then
  cartella="content/disegni/$slug"
  file="$cartella/index.md"
else
  cartella=""
  file="content/$sezione/$slug.md"
fi

[[ -e $file ]] && errore "esiste già: $file"

if [[ -n $immagine ]]; then
  [[ $sezione == disegni ]] || errore "l'immagine si passa solo a 'disegno'"
  [[ -f $immagine ]] || errore "non trovo l'immagine: $immagine"
fi

mkdir -p "$(dirname "$file")"

{
  echo '---'
  printf 'title: "%s"\n' "${titolo//\"/\\\"}"
  echo "date: $data"
  echo 'description: ""'
  echo 'tags: []'
  echo 'draft: true'
  echo '---'
  echo
  if [[ -n $sorgente ]]; then
    # Se la nota avesse già un front matter suo finirebbe doppio: lo salto.
    if [[ "$(head -n1 "$sorgente")" == '---' ]]; then
      sed '1{/^---$/!q}; 1,/^---$/d' "$sorgente"
    else
      cat "$sorgente"
    fi
  fi
} >"$file"

[[ -n $immagine ]] && cp "$immagine" "$cartella/"

echo "creato: $file"
[[ -n $immagine ]] && echo "        $cartella/$(basename "$immagine")"

if [[ -n $sorgente ]] && grep -q '\[\[' "$file"; then
  quanti="$(grep -o '\[\[[^]]*\]\]' "$file" | wc -l)"
  echo
  echo "attenzione: $quanti wikilink [[...]] nel testo."
  echo "Hugo non li rende, resterebbero le parentesi quadre. Vanno sistemati a mano."
fi

if [[ $sezione == disegni && -z $immagine ]]; then
  echo
  echo "nota: nessuna immagine. Mettila dentro $cartella/ prima di pubblicare."
fi

if ((apri_editor)) && [[ -n ${EDITOR:-} ]]; then
  "$EDITOR" "$file"
fi
